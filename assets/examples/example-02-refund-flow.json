  "product": {
    "name": "售后退款审批",
    "oneLiner": "让用户 3 步提交退款申请，让客服 1 屏完成审批",
    "positioning": "面向电商中小商家的售后工具。用户侧把退款申请压缩到 3 步，客服侧把审批所需信息全部前置到一屏内，减少来回沟通。",
    "targetUsers": [
      "C 端用户",
      "客服专员",
      "财务审核员"
    ],
    "coreValue": "退款申请一次提交成功率从 62% 提升到 90%",
    "nonGoals": [
      "不做自动风控决策模型",
      "不做物流对接与退货上门取件",
      "不做多币种结算"
