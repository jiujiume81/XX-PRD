        "pageIds": [
          "page-refund-apply",
          "page-refund-review"
        ],
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "key": "pk",
            "note": "ULID"
          },
          {
            "name": "orderNo",
            "type": "string",
            "required": true,
            "note": "关联订单号"
          },
          {
            "name": "reason",
            "type": "string",
            "required": true,
            "constraint": "≤ 200 字",
