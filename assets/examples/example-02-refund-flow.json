          },
          {
            "name": "amount",
            "type": "number",
            "required": true,
            "constraint": "> 0 且 ≤ 订单金额",
            "note": "退款金额（元）"
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "constraint": "submitted|reviewing|approved|rejected|refunded",
            "note": "见 sm-refund 状态机"
          },
          {
            "name": "applicantId",
            "type": "string",
            "required": true,
            "key": "fk",
            "note": "→ user.id"
          },
          {
            "name": "reviewerId",
            "type": "string",
            "required": false,
            "key": "fk",
            "note": "→ user.id，审批人"
          },
          {
            "name": "createdAt",
            "type": "datetime",
            "required": true,
            "note": ""
          }
        ],
        "relations": [
          {
            "type": "belongs_to",
            "target": "e-order",
            "via": "orderNo",
            "note": ""
          },
          {
            "type": "belongs_to",
            "target": "e-user",
            "via": "applicantId",
            "note": "申请人"
          }
        ],
        "indexes": [
          "orderNo",
          "status"
        ]
      },
      {
        "id": "e-order",
        "name": "Order",
        "table": "orders",
        "description": "被退款的订单",
        "pageIds": [
          "page-refund-apply"
        ],
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "key": "pk",
            "note": ""
          },
          {
            "name": "no",
            "type": "string",
            "required": true,
            "unique": true,
            "note": "订单号"
          },
          {
            "name": "amount",
            "type": "number",
            "required": true,
            "note": "订单金额，退款金额上限"
          },
          {
            "name": "paidAt",
            "type": "datetime",
            "required": true,
            "note": "支付时间，退款时限判断依据"
          }
        ],
        "relations": [
          {
            "type": "has_many",
            "target": "e-refund",
