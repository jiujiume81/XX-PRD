  "requirements": [
    {
      "id": "REQ-IQC-001",
      "pageId": "page-iqc-new",
      "moduleId": "m-iqc",
      "ui": {
        "interactionId": "ix-save"
      },
      "title": "保存检验任务",
      "pattern": "event-driven",
      "trigger": "检验员填完物资、批次号与请验数量后点击「保存为待检验」",
      "rule": "三个必填项齐全，批次号在 30 天内不得重复建任务",
      "expected": "生成状态为「待检验」的任务并回到列表，列表首行出现该任务",
      "stateMachine": "sm-iqc",
      "role": "u-inspector",
      "status": "confirmed",
      "source": "user",
      "acceptance": [
        "必填项为空时保存被拒绝，提示缺哪一项",
        "重复批次号保存时提示「该批次已有在检任务」，并给出跳转"
      ]
    },
    {
      "id": "REQ-IQC-002",
      "pageId": "page-iqc-list",
      "moduleId": "m-iqc",
      "ui": {
        "interactionId": "ix-start"
      },
      "title": "开始检验",
      "pattern": "state-driven",
      "trigger": "检验员在「待检验」任务上点击「开始」",
      "rule": "仅 pending 状态可开始；同一任务不可被两人同时开始",
      "expected": "状态变为「检验中」，开始时间落库，他人界面上的「开始」置灰",
      "stateMachine": "sm-iqc",
      "role": "u-inspector",
      "status": "confirmed",
      "source": "user",
      "acceptance": [
        "非待检验状态下「开始」不可点，并说明当前状态",
        "两人同时点「开始」时，后到的一方收到「已被某某锁定」"
      ]
    },
    {
      "id": "REQ-IQC-003",
      "pageId": "page-iqc-list",
      "moduleId": "m-iqc",
      "ui": {
        "interactionId": "ix-export"
      },
      "title": "导出筛选结果",
      "pattern": "event-driven",
      "trigger": "点击标题带的「导出」",
      "rule": "导出范围 = 当前筛选条件，不受分页限制；导出时若单据状态已变更，拒绝导出该行",
      "expected": "生成 xlsx，列与列宽与列表一致",
      "stateMachine": "sm-iqc",
      "role": "u-inspector",
      "status": "confirmed",
      "source": "user",
      "acceptance": [
        "342 条全部导出，不是当前页 20 条",
