{
  "meta": {
    "schemaVersion": "1.1",
    "product": "来料检验管理系统",
    "version": "0.1.0",
    "createdAt": "2026-10-22T11:00:00+08:00",
    "updatedAt": "2026-10-22T11:00:00+08:00",
    "reviewMode": false,
    "currentPageId": "page-iqc-list",
    "defaultPanel": "both",
    "note": "P9 B 分支样本：2 行数据，第 1 行 = 1 行盒、第 2 行 = **实测 3 行盒**（列 lot 配了 wrap:true / maxLines:2，但 146px 下这个值断成 3 行；maxLines 只是视觉裁切，不改行盒数）—— 两组各 1 行，极差无从算，故 P9 只能报条件式 SKIP"
  },
  "product": {
    "name": "来料检验管理系统",
    "oneLiner": "把「这批料能不能用」变成一条可追溯的检验记录。",
    "positioning": "面向锂电材料厂的质检中后台，解决「待检任务在哪、标准是什么、判定归谁」三个问题。",
    "nonGoals": [
      "不做供应商绩效评分",
      "不做实验室仪器排程",
      "不做 SPC 过程控制图"
    ],
    "metrics": [
      {
        "name": "来料检验及时率",
        "type": "ratio",
        "target": "≥ 95%"
      },
      {
        "name": "单任务平均处理时长",
        "type": "duration",
        "target": "中位数 ≤ 6 小时"
      }
    ]
  },
  "users": [
    {
      "id": "u-inspector",
      "name": "检验员",
      "description": "负责取样、送检、录入检验结果",
      "goals": [
        "一眼看到今天还有多少待检",
        "打开任务就知道该按哪个标准做"
      ]
    },
    {
      "id": "u-engineer",
      "name": "质量工程师",
      "description": "负责判定、复检与不合格品处置",
      "goals": [
        "看到超期与不合格的分布",
        "判定时能追溯历史批次"
      ]
    },
    {
      "id": "u-warehouse",
      "name": "仓库管理员",
      "description": "负责请验与待检区隔离",
      "goals": [
        "知道哪些批次已放行"
      ]
    }
  ],
  "tasks": [
    {
      "id": "task-iqc-track",
      "name": "跟踪来料检验任务",
      "actor": "u-inspector",
      "goal": "找到目标批次并推进到检验中",
      "inputs": [
        "任务单号 / 批次号 / 物资名称"
      ],
      "doneWhen": "任务已开始检验",
      "pages": [
        "page-iqc-list"
      ]
    },
    {
      "id": "task-iqc-create",
      "name": "新建检验任务",
      "actor": "u-inspector",
      "goal": "把请验单转成可执行的检验任务",
      "inputs": [
        "物资",
        "批次号",
        "请验数量"
      ],
      "doneWhen": "任务已保存为待检验",
      "pages": [
        "page-iqc-new"
      ]
    },
    {
      "id": "task-iqc-stats",
      "name": "查看检验趋势",
      "actor": "u-engineer",
      "goal": "判断这个月质量在变好还是变坏",
      "inputs": [
        "时间范围"
      ],
      "doneWhen": "已看清趋势",
      "pages": [
        "page-iqc-stats"
      ]
    }
  ],
  "userFlows": [
    {
      "id": "flow-iqc",
      "name": "来料检验主流程",
      "role": "u-inspector",
      "goal": "从请验到放行",
      "steps": [
        {
          "id": "fs-1",
          "name": "新建检验任务",
          "pageId": "page-iqc-new",
          "note": "保存为待检验"
        },
        {
          "id": "fs-2",
          "name": "找到并开始检验",
          "pageId": "page-iqc-list",
          "note": "待检验 → 检验中"
        },
        {
          "id": "fs-3",
          "name": "录入结果并判定",
          "pageId": "page-iqc-list",
          "note": "检验中 → 待判定 → 已关闭"
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "m-iqc",
      "name": "来料检验",
      "priority": "P0",
      "goal": "覆盖请验、检验、判定与放行的闭环",
      "pageIds": [
        "page-iqc-list",
        "page-iqc-new",
        "page-iqc-stats"
      ]
    }
  ],
