  "stateMachines": [
    {
      "id": "sm-iqc",
      "name": "检验任务状态机",
      "entity": "InspectionTask",
      "initial": "pending",
      "states": [
        {
          "id": "pending",
          "name": "待检验",
          "type": "warning"
        },
        {
          "id": "testing",
          "name": "检验中",
          "type": "processing"
        },
        {
          "id": "review",
          "name": "待判定",
          "type": "normal"
        },
        {
          "id": "closed",
          "name": "已关闭",
          "type": "disabled"
        }
      ],
      "transitions": [
        {
          "id": "t-iqc-1",
          "from": "pending",
          "to": "testing",
          "trigger": "检验员点击「开始检验」",
          "role": "u-inspector",
          "guard": "任务未被他人锁定",
          "action": "记录开始时间并锁定任务",
          "ui": {
            "pageId": "page-iqc-list",
            "interactionId": "ix-start"
          }
        },
        {
          "id": "t-iqc-2",
          "from": "testing",
          "to": "review",
          "trigger": "检验员提交检验结果",
          "role": "u-inspector",
          "guard": "全部检验项目均已录入",
          "action": "生成结果快照并通知质量工程师",
          "ui": {
            "pageId": "page-iqc-list",
            "interactionId": "ix-submit"
          }
        },
        {
          "id": "t-iqc-3",
          "from": "review",
          "to": "closed",
          "trigger": "质量工程师判定合格",
          "role": "u-engineer",
          "guard": "所有项目结论为合格",
          "action": "放行批次并解锁待检区",
          "ui": {
            "pageId": "page-iqc-list",
            "interactionId": "ix-approve"
          }
        },
        {
          "id": "t-iqc-4",
          "from": "review",
          "to": "testing",
          "trigger": "质量工程师判定需复检",
          "role": "u-engineer",
          "guard": "至少一项结论不合格",
