  "requirements": [
    {
      "id": "REQ-FX-001",
      "pageId": "page-task-hub",
      "moduleId": "m-fx",
      "ui": {
        "interactionId": "ix-fx-submit"
      },
      "title": "责任人提交执行结果",
      "pattern": "event-driven",
      "trigger": "责任人在「我的任务」点击「提交执行结果」",
      "rule": "措施必须已填执行说明与佐证",
      "expected": "措施状态由「待执行」变为「待验证」，且只有该责任人的任务可见",
      "stateMachine": "sm-measure",
      "role": "u-exec",
      "status": "confirmed",
      "source": "user",
      "acceptance": [
        "点击「提交执行结果」后措施变为「待验证」，编辑入口消失",
        "未填佐证时提交被拒绝，提示「请先上传佐证」",
        "非本人任务不出现在列表中，直接访问详情提示无权限"
      ]
    },
    {
      "id": "REQ-FX-002",
      "pageId": "page-verify",
      "moduleId": "m-fx",
      "ui": {
        "interactionId": "ix-fx-verify"
      },
      "title": "质量工程师出验证结论",
      "pattern": "event-driven",
      "trigger": "质量工程师在「措施验证」点击「验证通过」",
      "rule": "验证人不得与执行人相同（四眼原则）",
      "expected": "措施变为「已完成」，主任务单回到待关闭",
      "stateMachine": "sm-measure",
      "role": "u-qa",
      "status": "confirmed",
      "source": "user",
      "acceptance": [
        "点击「验证通过」后措施变为「已完成」，并写回主任务单",
        "执行人自己不能出现在验证人候选里",
        "措施处于「待执行」时「验证通过」置灰并提示当前状态不允许"
      ]
    }
